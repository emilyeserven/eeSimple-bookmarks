# PostgreSQL connection string used by Drizzle and the Fastify API.
# Matches the local docker-compose database (see repo-root docker-compose.yml).
DATABASE_URL=postgresql://postgres:password@localhost:5432/app

# Optional: override the API port (defaults to 3001).
# PORT=3001

# Optional: Postgres connection pool size (default 5 — sized for a Raspberry Pi).
# DB_POOL_MAX=5

# Optional: expose the Swagger/OpenAPI docs at /docs. Defaults to on outside production and off in
# production. The API is unauthenticated, so enabling it in production makes the full API surface
# publicly explorable — enable deliberately.
# DOCS_ENABLED=true

# Object storage (Garage / any S3-compatible store) for /api/files.
# For `pnpm dev` the middleware runs on the host, so point at the host-mapped Garage port.
# Fill ACCESS_KEY_ID / SECRET_ACCESS_KEY with the key created during the one-time Garage
# bootstrap (see README → "Object storage (Garage)"). File routes return 503 until these are set.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
